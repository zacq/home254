# Postgres connection string. Netlify DB's NETLIFY_DATABASE_URL is also picked up.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Signs admin sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# First owner account, created on the first login when no admin users exist.
# Password must be at least 10 characters. Change it in Admin > My account afterwards.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# Optional. On Netlify this falls back to the site's URL.
NEXT_PUBLIC_SITE_URL=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
